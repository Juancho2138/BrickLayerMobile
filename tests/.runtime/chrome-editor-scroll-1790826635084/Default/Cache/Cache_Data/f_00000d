}

function observeGridViewport() {
  if (!("ResizeObserver" in window)) {
    window.addEventListener("resize", refitGridIfNeeded);
    return;
  }
  const observer = new ResizeObserver(() => {
    refitGridIfNeeded();
  });
  observer.observe(els.gridScroller);
}

