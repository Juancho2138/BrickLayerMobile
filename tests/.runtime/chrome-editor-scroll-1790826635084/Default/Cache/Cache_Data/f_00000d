}

function themeFromBackground(background) {
  const bg = normalizeHexColor(background);
  const rgb = hexToRgb(bg);
  const isLight = relativeLuminance(bg) > 0.48;
  if (isLight) {
    return {
      colorScheme: "light",
      appBg: bg,
      panelBg: mixHex(bg, "#000000", 0.08),
      panelSoftBg: mixHex(bg, "#000000", 0.14),
      editorBg: mixHex(bg, "#000000", 0.05),
      controlBg: mixHex(bg, "#000000", 0.03),
      surfaceBg: mixHex(bg, "#000000", 0.1),
      textPrimary: "#12151b",
      textSecondary: "#4f5968",
      borderColor: mixHex(bg, "#000000", 0.26),
      topbarBg: `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.96)`,
      overlayShadow: "0 18px 42px rgba(20, 24, 32, 0.2)"
    };
  }
  return {
    colorScheme: "dark",
    appBg: bg,
    panelBg: mixHex(bg, "#ffffff", 0.07),
    panelSoftBg: mixHex(bg, "#ffffff", 0.13),
    editorBg: mixHex(bg, "#000000", 0.28),
    controlBg: mixHex(bg, "#000000", 0.18),
    surfaceBg: mixHex(bg, "#ffffff", 0.04),
    textPrimary: "#f4f7fb",
    textSecondary: "#aab3c2",
    borderColor: mixHex(bg, "#ffffff", 0.22),
    topbarBg: `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.96)`,
    overlayShadow: "0 18px 42px rgba(0, 0, 0, 0.42)"
  };
}

function applyAppearance() {
  const background = currentInterfaceBackground();
  const theme = themeFromBackground(background);
  const root = document.documentElement;
  root.style.colorScheme = theme.colorScheme;
  root.style.setProperty("--app-bg", theme.appBg);
  root.style.setProperty("--panel-bg", theme.panelBg);
  root.style.setProperty("--panel-soft-bg", theme.panelSoftBg);
  root.style.setProperty("--editor-bg", theme.editorBg);
  root.style.setProperty("--control-bg", theme.controlBg);
  root.style.setProperty("--surface-bg", theme.surfaceBg);
  root.style.setProperty("--text-primary", theme.textPrimary);
  root.style.setProperty("--text-secondary", theme.textSecondary);
  root.style.setProperty("--border-color", theme.borderColor);
  root.style.setProperty("--bg", theme.appBg);
  root.style.setProperty("--panel", theme.panelBg);
  root.style.setProperty("--panel-soft", theme.panelSoftBg);
  root.style.setProperty("--text", theme.textPrimary);
  root.style.setProperty("--muted", theme.textSecondary);
  root.style.setProperty("--line", theme.borderColor);
  root.style.setProperty("--topbar-bg", theme.topbarBg);
  root.style.setProperty("--overlay-shadow", theme.overlayShadow);
  root.style.setProperty("--viewer3d-bg", currentViewerBackground());
  updateAppearanceControls();
}

function updateAppearanceControls() {
  if (els.customBackgroundColor) els.customBackgroundColor.value = normalizeHexColor(state.appearance.customBackground);
  els.backgroundPresetBtns?.forEach((button) => {
    button.classList.toggle("active", button.dataset.appBackground === state.appearance.backgroundMode);
  });
  if (els.customViewerBackgroundColor) els.customViewerBackgroundColor.value = normalizeHexColor(state.appearance.customViewerBackground, VIEWER3D_BACKGROUND_PRESETS.dark);
  els.viewerBackgroundPresetBtns?.forEach((button) => {
    button.classList.toggle("active", button.dataset.viewerBackground === state.appearance.viewerBackgroundMode);
  });
}

function saveAppearance() {
  localStorage.setItem(APPEARANCE_STORAGE_KEY, JSON.stringify(state.appearance));
}

function loadAppearance() {
  const saved = localStorage.getItem(APPEARANCE_STORAGE_KEY);
  if (!saved) {
    applyAppearance();
    return;
  }
  try {
    const parsed = JSON.parse(saved);
    const mode = parsed.backgroundMode === "custom" || Object.prototype.hasOwnProperty.call(BACKGROUND_PRESETS, parsed.backgroundMode) ? parsed.backgroundMode : "default";
    state.appearance = {
      backgroundMode: mode,
      customBackground: normalizeHexColor(parsed.customBackground, DEFAULT_INTERFACE_BACKGROUND),
      viewerBackgroundMode: parsed.viewerBackgroundMode === "custom" || Object.prototype.hasOwnProperty.call(VIEWER3D_BACKGROUND_PRESETS, parsed.viewerBackgroundMode) ? parsed.viewerBackgroundMode : "dark",
      customViewerBackground: normalizeHexColor(parsed.customViewerBackground, VIEWER3D_BACKGROUND_PRESETS.dark)
    };
  } catch {
    state.appearance = {
      backgroundMode: "default",
      customBackground: DEFAULT_INTERFACE_BACKGROUND,
      viewerBackgroundMode: "dark",
      customViewerBackground: VIEWER3D_BACKGROUND_PRESETS.dark
    };
  }
  applyAppearance();
}

function setInterfaceBackground(mode, color) {
  state.appearance.backgroundMode = mode;
  if (color) state.appearance.customBackground = normalizeHexColor(color);
  applyAppearance();
  saveAppearance();
  refitGridIfNeeded();
}

function resetInterfaceBackground() {
  state.appearance = {
    backgroundMode: "default",
    customBackground: DEFAULT_INTERFACE_BACKGROUND,
    viewerBackgroundMode: state.appearance.viewerBackgroundMode,
    customViewerBackground: state.appearance.customViewerBackground
  };
  applyAppearance();
  saveAppearance();
  refitGridIfNeeded();
}

function setViewerBackground(mode, color) {
  state.appearance.viewerBackgroundMode = mode;
  if (color) state.appearance.customViewerBackground = normalizeHexColor(color, VIEWER3D_BACKGROUND_PRESETS.dark);
  applyAppearance();
  saveAppearance();
  refreshOpen3dViewer();
}

function resetViewerBackground() {
  state.appearance.viewerBackgroundMode = "dark";
  state.appearance.customViewerBackground = VIEWER3D_BACKGROUND_PRESETS.dark;
  applyAppearance();
  saveAppearance();
  refreshOpen3dViewer();
}

function renderGrid() {
  const { x, y } = state.project.size;
  const activeReferences = activeReferencesForCurrentLayer();
  const organizationMap = organizationPieceMapForCurrentLayer();
  els.grid.style.setProperty("--x", x);
  els.grid.style.setProperty("--y", y);
  els.grid.style.setProperty("--cell", `${els.gridZoom.value}px`);
  els.grid.style.setProperty("--block-opacity", String(state.imageState.blockOpacity / 100));
  els.grid.innerHTML = "";

  const corner = document.createElement("div");
  corner.className = "axis corner";
  els.grid.appendChild(corner);

  for (let col = 0; col < x; col += 1) {
    const axis = document.createElement("div");
    axis.className = "axis";
    axis.textContent = col + 1;
    els.grid.appendChild(axis);
  }

  const matrix = currentLayer().matrix;
  for (let row = 0; row < y; row += 1) {
    const axis = document.createElement("div");
    axis.className = "axis";
    axis.textContent = row + 1;
    els.grid.appendChild(axis);

    for (let col = 0; col < x; col += 1) {
      const code = getCell(matrix, col, row);
      const cell = document.createElement("button");
      cell.type = "button";
      cell.className = `cell${code !== "." ? " occupied" : ""}${organizationEdgeClasses(organizationMap, col, row)}`;
      cell.dataset.x = col;
      cell.dataset.y = row;
      cell.ariaLabel = `X ${col + 1}, Y ${row + 1}`;
      cell.style.background = code === "." ? "" : state.project.palette[code];
      const referencesHere = activeReferences.filter((reference) => reference.x === col && reference.y === row);
      if (referencesHere.length) {
        cell.ariaLabel += `, Referencias ${referencesHere.map((reference) => reference.id).join(", ")}, Capa ${currentLayer().z}`;
      }
      referencesHere.forEach((reference) => {
        const marker = document.createElement("span");
        marker.className = `reference-marker ${referenceClass(reference)}`;
        const label = document.createElement("span");
        label.textContent = referenceShortLabel(reference);
        marker.appendChild(label);
        cell.appendChild(marker);
      });
      els.grid.appendChild(cell);
    }
  }
  const gridStyle = getComputedStyle(els.grid);
  const contentWidth = els.grid.offsetWidth + parseFloat(gridStyle.marginLeft || 0) + parseFloat(gridStyle.marginRight || 0);
  const contentHeight = els.grid.offsetHeight + parseFloat(gridStyle.marginTop || 0) + parseFloat(gridStyle.marginBottom || 0);
  els.gridScrollContent.style.width = `${Math.ceil(contentWidth)}px`;
  els.gridScrollContent.style.height = `${Math.ceil(contentHeight)}px`;
}

function organizationPieceMapForCurrentLayer() {
  if (!els.showOrganizationToggle.checked || state.project.construction_layout?.outdated) return null;
  const layout = state.project.construction_layout;
  if (!layout?.pieces?.length) return null;
  const z = currentLayer().z;
  const map = new Map();
  layout.pieces
    .filter((piece) => piece.z === z)
    .forEach((piece) => {
      piece.cells.forEach(([x, y]) => map.set(`${x},${y}`, piece.id));
    });
  return map;
}

function organizationEdgeClasses(map, col, row) {
  if (!map) return "";
  const id = map.get(`${col},${row}`);
  if (!id) return "";
  const classes = [];
  if (map.get(`${col},${row - 1}`) !== id) classes.push("organization-edge-top");
  if (map.get(`${col + 1},${row}`) !== id) classes.push("organization-edge-right");
  if (map.get(`${col},${row + 1}`) !== id) classes.push("organization-edge-bottom");
  if (map.get(`${col - 1},${row}`) !== id) classes.push("organization-edge-left");
  return ` ${classes.join(" ")}`;
}

function activeReferencesForCurrentLayer() {
  const z = currentLayer().z;
  return state.project.references
    .filter((reference) => isReferenceVisibleAtZ(reference, z))
    .sort(compareReferenceIds);
}

function renderActiveReferences() {
  const references = activeReferencesForCurrentLayer();
  els.activeReferences.innerHTML = "";
  if (!references.length) {
    const empty = document.createElement("div");
    empty.className = "reference-list-empty";
    empty.textContent = "Sin referencias activas";
    els.activeReferences.appendChild(empty);
    return;
  }

  references.forEach((reference) => {
    const item = document.createElement("div");
    item.className = "reference-item";

    const name = document.createElement("div");
    name.className = "reference-name";
    const title = document.createElement("span");
    title.textContent = `${referenceShortLabel(reference)} ${reference.label || ""}`.trim();
    const position = document.createElement("small");
    position.textContent = referenceMeta(reference);
    name.append(title, position);

    const locate = document.createElement("button");
    locate.type = "button";
    locate.textContent = "Localizar";
    locate.addEventListener("click", () => locateReference(reference));

    const edit = document.createElement("button");
    edit.type = "button";
    edit.textContent = "Editar";
    edit.addEventListener("click", () => openEditReferenceDialog(reference.id));

    const finish = document.createElement("button");
    finish.type = "button";
    finish.textContent = "Finalizar";
    finish.addEventListener("click", () => finishReference(reference.id));

    finish.hidden = normalizeReferenceType(reference.type) === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER;

    item.append(name, locate, edit, finish);
    els.activeReferences.appendChild(item);
  });
}

function referenceClass(reference) {
  const type = normalizeReferenceType(reference.type);
  if (type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER) return "reference-marker-temporary";
  if (type === REFERENCE_TYPES.BACKWARD) return "reference-marker-backward";
  return "reference-marker-normal";
}

function referenceShortLabel(reference) {
  if (normalizeReferenceType(reference.type) === REFERENCE_TYPES.BACKWARD) return `REF Z${reference.source_z}`;
  return reference.id;
}

function referenceMeta(reference) {
  const type = normalizeReferenceType(reference.type);
  if (type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER) {
    return `X ${reference.x + 1}, Y ${reference.y + 1}, origen Z${reference.source_z}, visible Z${reference.source_z + 1}`;
  }
  if (type === REFERENCE_TYPES.BACKWARD) {
    const end = reference.end_z === null ? "Z0..." : `Z${reference.end_z}`;
    return `X ${reference.x + 1}, Y ${reference.y + 1}, desde Z${reference.source_z} hacia ${end}`;
  }
  return `X ${reference.x + 1}, Y ${reference.y + 1}, desde Z${reference.start_z}`;
}

function updateButtons() {
  document.querySelectorAll(".tool").forEach((button) => {
    button.classList.toggle("active", button.dataset.tool === state.tool);
  });
  document.querySelectorAll(".reference-type-btn").forEach((button) => {
    button.classList.toggle("active", normalizeReferenceType(button.dataset.referenceMode) === state.referenceMode);
  });
  els.prevLayerBtn.disabled = state.currentLayer === 0;
  els.nextLayerBtn.disabled = state.currentLayer >= state.project.layers.length - 1;
  els.copyPrevLayerBtn.disabled = !state.project.layers.some((layer) => layer.z === currentLayer().z - 1);
  els.deleteLayerBtn.disabled = state.project.layers.length === 1;
  els.undoBtn.disabled = state.undoStack.length === 0;
  els.redoBtn.disabled = state.redoStack.length === 0;
  renderEditorState();
}

function paintAt(col, row) {
  if (state.editorLocked) return;
  if (state.tool === "reference") {
    const existing = findActiveReferenceAt(col, row);
    if (existing) {
      openEditReferenceDialog(existing.id);
      return;
    }
    createReferenceAt(col, row);
    return;
  }
  if (state.tool === "select") {
    const reference = findActiveReferenceAt(col, row);
    if (reference) openEditReferenceDialog(reference.id);
    return;
  }
  if (state.tool === "template") {
    setStatus("Plantilla activa.");
    return;
  }
  const matrix = currentLayer().matrix;
  const value = state.tool === "erase" ? "." : state.selectedColor;
  if (state.tool === "fill") {
    fillFrom(col, row);
    return;
  }
  if (getCell(matrix, col, row) === value) return;
  setCell(matrix, col, row, value);
  updateCellElement(col, row, value);
  markGeometryChanged();
}

function updateCellElement(col, row, value) {
  const cell = els.grid.querySelector(`.cell[data-x="${col}"][data-y="${row}"]`);
  if (!cell) return;
  cell.classList.toggle("occupied", value !== ".");
  cell.style.background = value === "." ? "" : state.project.palette[value];
}

function fillFrom(col, row) {
  const matrix = currentLayer().matrix;
  const target = getCell(matrix, col, row);
  const replacement = state.selectedColor;
  if (target === replacement) return;

  pushHistory();
  const { x, y } = state.project.size;
  const queue = [[col, row]];
  const seen = new Set();
  while (queue.length) {
    const [cx, cy] = queue.shift();
    const key = `${cx},${cy}`;
    if (seen.has(key) || cx < 0 || cy < 0 || cx >= x || cy >= y) continue;
    seen.add(key);
    if (getCell(matrix, cx, cy) !== target) continue;
    setCell(matrix, cx, cy, replacement);
    queue.push([cx + 1, cy], [cx - 1, cy], [cx, cy + 1], [cx, cy - 1]);
  }
  renderGrid();
  markGeometryChanged("Relleno aplicado.");
}

function beginDraw(event) {
  const cell = event.target.closest(".cell");
  if (!cell) return;
  if (state.editorLocked || event.pointerType === "touch" && event.isPrimary === false) return;
  event.preventDefault();
  state.isDrawing = true;
  state.lastTouched = null;
  state.dragStart = { x: event.clientX, y: event.clientY, moved: false };
  if (state.tool !== "fill" && state.tool !== "reference" && state.tool !== "select" && state.tool !== "template") pushHistory();
  touchCell(cell);
}

function moveDraw(event) {
  if (!state.isDrawing || state.tool === "fill" || state.tool === "reference" || state.tool === "select") return;
  if (!state.dragPaintEnabled) return;
  const point = event.touches ? event.touches[0] : event;
  if (state.dragStart && !state.dragStart.moved) {
    const dx = Math.abs(point.clientX - state.dragStart.x);
    const dy = Math.abs(point.clientY - state.dragStart.y);
    if (dx < 10 && dy < 10) return;
    state.dragStart.moved = true;
  }
  event.preventDefault();
  const target = document.elementFromPoint(point.clientX, point.clientY);
  const cell = target?.closest(".cell");
  if (cell && els.grid.contains(cell)) touchCell(cell);
}

function endDraw() {
  state.isDrawing = false;
  state.lastTouched = null;
  state.dragStart = null;
}

function touchCell(cell) {
  const col = Number(cell.dataset.x);
  const row = Number(cell.dataset.y);
  const key = `${col},${row}`;
  if (state.lastTouched === key) return;
  state.lastTouched = key;
  paintAt(col, row);
}

function findActiveReferenceAt(col, row) {
  return activeReferencesForCurrentLayer().find((reference) => reference.x === col && reference.y === row);
}

function openCreateReferenceDialog(col, row) {
  state.pendingPoint = { x: col, y: row };
  state.editingReferenceId = null;
  els.pointDialogTitle.textContent = `Nuevo punto en X ${col + 1}, Y ${row + 1}`;
  els.pointLabel.value = "";
  els.pointPersistent.checked = true;
  els.pointPersistentWrap.hidden = false;
  els.finishPointBtn.hidden = true;
  els.deletePointBtn.hidden = true;
  els.pointDialog.showModal();
}

function createReferenceAt(col, row) {
  const z = currentLayer().z;
  const id = nextReferenceId();
  const type = normalizeReferenceType(state.referenceMode);
  pushHistory();
  state.project.references.push({
    id,
    x: col,
    y: row,
    type,
    source_z: z,
    start_z: type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER ? z + 1 : z,
    end_z: type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER ? z + 1 : null,
    label: ""
  });
  state.project.references.sort(compareReferenceIds);
  render();
  markChanged(`${id} ${referenceTypeLabel(type)} creada en X ${col + 1}, Y ${row + 1}, Z${z}.`);
}

function openEditReferenceDialog(id) {
  const reference = state.project.references.find((item) => item.id === id);
  if (!reference) return;
  state.pendingPoint = null;
  state.editingReferenceId = id;
  els.pointDialogTitle.textContent = `${referenceShortLabel(reference)} | X ${reference.x + 1} | Y ${reference.y + 1} | ${referenceTypeLabel(reference.type)}`;
  els.pointLabel.value = reference.label || "";
  els.pointPersistentWrap.hidden = true;
  els.finishPointBtn.hidden = false;
  els.deletePointBtn.hidden = false;
  els.pointDialog.showModal();
}

function savePointDialog() {
  const label = els.pointLabel.value.trim();
  if (state.editingReferenceId) {
    const reference = state.project.references.find((item) => item.id === state.editingReferenceId);
    if (!reference) return;
    pushHistory();
    reference.label = label;
    closePointDialog();
    render();
    markChanged("Referencia editada.");
    return;
  }

  if (!state.pendingPoint) return;
  pushHistory();
  const z = currentLayer().z;
  const type = els.pointPersistent.checked ? REFERENCE_TYPES.NORMAL : REFERENCE_TYPES.TEMPORAL_NEXT_LAYER;
  state.project.references.push({
    id: nextReferenceId(),
    x: state.pendingPoint.x,
    y: state.pendingPoint.y,
    type,
    source_z: z,
    start_z: type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER ? z + 1 : z,
    end_z: type === REFERENCE_TYPES.TEMPORAL_NEXT_LAYER ? z + 1 : null,
    label
  });
  state.project.references.sort(compareReferenceIds);
  closePointDialog();
  render();
  markChanged("Punto de referencia creado.");
}

function closePointDialog() {
  state.pendingPoint = null;
  state.editingReferenceId = null;
  els.pointDialog.close();
}

function finishReference(id) {
  const reference = state.project.references.find((item) => item.id === id);
  if (!reference) return;
  const z = currentLayer().z;
  pushHistory();
  if (normalizeReferenceType(reference.type) === REFERENCE_TYPES.BACKWARD) {
    reference.end_z = Math.min(reference.source_z, z);
  } else {
    reference.end_z = Math.max(reference.start_z, z);
  }
  render();
  markChanged(`${reference.id} finalizada en Z ${reference.end_z}.`);
}

function deleteReference(id) {
  const index = state.project.references.findIndex((item) => item.id === id);
  if (index === -1) return;
  if (!confirm("Eliminar esta referencia completamente?")) return;
  pushHistory();
  const [removed] = state.project.references.splice(index, 1);
  closePointDialog();
  render();
  markChanged(`${removed.id} eliminada.`);
}

function locateReference(reference) {
  const targetLayer = state.project.layers.findIndex((layer) => layer.z === reference.start_z);
  if (targetLayer !== -1 && targetLayer !== state.currentLayer) {
    state.currentLayer = targetLayer;
    render();
  }
  const cell = els.grid.querySelector(`.cell[data-x="${reference.x}"][data-y="${reference.y}"]`);
  if (!cell) return;
  cell.scrollIntoView({ block: "center", inline: "center" });
  cell.classList.add("active");
  window.setTimeout(() => cell.classList.remove("active"), 700);
}

let viewer3dApiPromise = null;
let viewer3dInstance = null;
let organizerApiPromise = null;
let pdfEnginePromise = null;
let currentPdfDownload = null;

function open3dViewer() {
  console.log("[BrickLayer] Vista 3D solicitada");
  if (location.protocol === "file:") {
    setStatus("Para utilizar Vista 3D abre BrickLayer desde el servidor local.");
    return;
  }
  if (!els.open3dBtn || !els.viewer3dDialog || !els.viewer3dCanvasWrap) {
    console.error("[BrickLayer] Elementos del visor 3D no encontrados.");
    setStatus("No se pudo abrir la Vista 3D.");
    return;
  }
  if (!els.viewer3dDialog.open) {
    els.viewer3dInfo.textContent = "Cargando visor 3D...";
    try {
      els.viewer3dDialog.showModal();
    } catch (error) {
      console.error("[BrickLayer] No se pudo abrir el modal 3D:", error);
      setStatus("No se pudo abrir la Vista 3D.");
      return;
    }
  }
  setStatus("Preparando Vista 3D...");
  const options = create3dViewerOptions();
  if (!viewer3dApiPromise) {
    viewer3dApiPromise = import(VIEWER3D_MODULE_URL);
  }
  viewer3dApiPromise
    .then((module) => {
      module.openBrickViewer(options);
      viewer3dInstance = module;
      setStatus("Vista 3D abierta.");
    })
    .catch((error) => {
      console.error("[BrickLayer] Error al abrir Vista 3D:", error);
      viewer3dApiPromise = null;
      els.viewer3dInfo.textContent = "No se pudo cargar el visor 3D.";
      setStatus("No se pudo abrir la Vista 3D.");
    });
}

function create3dViewerOptions() {
  return {
    dialog: els.viewer3dDialog,
    container: els.viewer3dCanvasWrap,
    info: els.viewer3dInfo,
    layerSelect: els.viewer3dLayerSelect,
    allLayers: els.viewer3dAllLayers,
    controls: {
      recolorToggle: els.viewer3dRecolorToggle,
      recolorPanel: els.viewer3dRecolorPanel,
      modeConnected: els.viewer3dModeConnected,
      modeAllColor: els.viewer3dModeAllColor,
      actionReplace: els.viewer3dActionReplace,
      actionAdd: els.viewer3dActionAdd,
      actionRemove: els.viewer3dActionRemove,
      selectionCount: els.viewer3dSelectionCount,
      selectionColor: els.viewer3dSelectionColor,
      palette: els.viewer3dColorPalette,
      colorSwatch: els.viewer3dColorSwatch,
      colorPopover: els.viewer3dColorPopover,
      applyColor: els.viewer3dApplyColor,
      clearSelection: els.viewer3dClearSelection,
      exitRecolor: els.viewer3dExitRecolor
    },
    project: JSON.parse(JSON.stringify(normalizeProject(state.project))),
    currentZ: currentLayer().z,
    getViewerBackground: currentViewerBackground,
    onApplyColor: apply3dColorBatch
  };
}

function apply3dColorBatch(selectionKeys, newColorCode) {
  if (!Array.isArray(selectionKeys) || !selectionKeys.length || !state.project.palette[newColorCode]) return null;
  pushHistory();
  const changes = recolorProjectVoxels(state.project, new Set(selectionKeys), newColorCode);
  if (!changes.length) {
    state.undoStack.pop();
    updateButtons();
    return JSON.parse(JSON.stringify(normalizeProject(state.project)));
  }
  renderPalette();
  render();
  markGeometryChanged(`Color aplicado a ${changes.length.toLocaleString("es-CO")} bloques.`);
  return JSON.parse(JSON.stringify(normalizeProject(state.project)));
}

function refreshOpen3dViewer() {
  if (!els.viewer3dDialog.open || location.protocol === "file:") return;
  if (!viewer3dApiPromise) {
    viewer3dApiPromise = import(VIEWER3D_MODULE_URL);
  }
  viewer3dApiPromise
    .then((module) => {
      module.openBrickViewer(create3dViewerOptions());
      viewer3dInstance = module;
    })
    .catch((error) => {
      console.error("[BrickLayer] Error al actualizar Vista 3D:", error);
      viewer3dApiPromise = null;
    });
}

function openOrganizer() {
  els.organizerDialog.showModal();
  renderOrganizerPanel();
}

function runOrganizer() {
  const maxPieceLength = Number(els.organizerMaxLength.value);
  const priority = els.organizerPriority.value;
  if (!organizerApiPromise) organizerApiPromise = import("./organizer.js");
  els.organizerSummary.textContent = "Organizando bloques...";
  return organizerApiPromise
    .then((module) => {
      const source = JSON.parse(JSON.stringify(normalizeProject(state.project)));
      const layout = module.generateConstructionLayout(source, { maxPieceLength, priority });
      const errors = module.validateConstructionLayout(source, layout);
      if (errors.length) {
        els.organizerSummary.textContent = `Error de organización: ${errors[0]}`;
        return false;
      }
      state.project.construction_layout = layout;
      saveProject();
      renderGrid();
      renderStats();
      renderOrganizerPanel();
      updatePdfSummary();
      setStatus("Organización actualizada.");
    })
    .catch((error) => {
      console.error("[BrickLayer] Error al organizar bloques:", error);
      els.organizerSummary.textContent = "No se pudo organizar el modelo.";
    });
}

