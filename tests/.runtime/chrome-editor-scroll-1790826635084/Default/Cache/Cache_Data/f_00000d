    imageX: state.imageState.x,
    imageY: state.imageState.y
  };
}

function moveImageDrag(event) {
  if (!state.imageDrag || state.imageDrag.pointerId !== event.pointerId) return;
  event.preventDefault();
  state.imageState.x = state.imageDrag.imageX + event.clientX - state.imageDrag.startX;
  state.imageState.y = state.imageDrag.imageY + event.clientY - state.imageDrag.startY;
  renderReference();
}

function endImageDrag(event) {
  if (!state.imageDrag || state.imageDrag.pointerId !== event.pointerId) return;
  state.imageDrag = null;
  markChanged();
}

function setZoom(value, options = {}) {
  if (!options.keepFitMode) state.zoomMode = "manual";
  els.gridZoom.value = String(clamp(Number(value), Number(els.gridZoom.min), Number(els.gridZoom.max)));
  renderGrid();
  renderEditorState();
  if (options.center) centerGridInViewport();
  else resetGridViewportMargins();
}

function zoomIn() {
  setZoom(Number(els.gridZoom.value) + 4);
}

function zoomOut() {
  setZoom(Number(els.gridZoom.value) - 4);
}

function fitZoom() {
  state.zoomMode = "fit";
  const cell = calculateFitCellSize();
  setZoom(cell, { keepFitMode: true, center: true });
}

function calculateFitCellSize() {
  const columns = Math.max(1, state.project.size.x + 1);
  const rows = Math.max(1, state.project.size.y + 1);
  const rect = els.gridScroller.getBoundingClientRect();
  const computed = getComputedStyle(els.gridScroller);
  const borderX = parseFloat(computed.borderLeftWidth) + parseFloat(computed.borderRightWidth);
  const borderY = parseFloat(computed.borderTopWidth) + parseFloat(computed.borderBottomWidth);
  const paddingX = parseFloat(computed.paddingLeft) + parseFloat(computed.paddingRight);
  const paddingY = parseFloat(computed.paddingTop) + parseFloat(computed.paddingBottom);
  const matrixPadding = 16;
  const margin = 16;
  const visibleWidth = rect.width || els.gridScroller.clientWidth;
  const visibleHeight = rect.height || els.gridScroller.clientHeight;
  const availableWidth = Math.max(1, visibleWidth - borderX - paddingX - matrixPadding - margin * 2);
  const availableHeight = Math.max(1, visibleHeight - borderY - paddingY - matrixPadding - margin * 2);
  const byWidth = Math.floor(availableWidth / columns);
  const byHeight = Math.floor(availableHeight / rows);
  return clamp(Math.min(byWidth, byHeight), Number(els.gridZoom.min), Number(els.gridZoom.max));
}

function centerGridInViewport() {
  requestAnimationFrame(() => {
    const gap = 8;
    const gridWidth = els.grid.offsetWidth;
    const gridHeight = els.grid.offsetHeight;
    els.grid.style.marginLeft = `${Math.max(gap, Math.floor((els.gridScroller.clientWidth - gridWidth) / 2))}px`;
    els.grid.style.marginTop = `${Math.max(gap, Math.floor((els.gridScroller.clientHeight - gridHeight) / 2))}px`;
    els.grid.style.marginRight = `${gap}px`;
    els.grid.style.marginBottom = `${gap}px`;
    const gridStyle = getComputedStyle(els.grid);
    const contentWidth = els.grid.offsetWidth + parseFloat(gridStyle.marginLeft || 0) + parseFloat(gridStyle.marginRight || 0);
    const contentHeight = els.grid.offsetHeight + parseFloat(gridStyle.marginTop || 0) + parseFloat(gridStyle.marginBottom || 0);
    els.gridScrollContent.style.width = `${Math.ceil(contentWidth)}px`;
    els.gridScrollContent.style.height = `${Math.ceil(contentHeight)}px`;
    const left = Math.max(0, (els.gridScrollContent.scrollWidth - els.gridScroller.clientWidth) / 2);
    const top = Math.max(0, (els.gridScrollContent.scrollHeight - els.gridScroller.clientHeight) / 2);
    els.gridScroller.scrollLeft = left;
    els.gridScroller.scrollTop = top;
  });
}

function resetGridViewportMargins() {
  els.grid.style.marginLeft = "8px";
  els.grid.style.marginTop = "8px";
  els.grid.style.marginRight = "8px";
  els.grid.style.marginBottom = "8px";
  const gridStyle = getComputedStyle(els.grid);
  const contentWidth = els.grid.offsetWidth + parseFloat(gridStyle.marginLeft || 0) + parseFloat(gridStyle.marginRight || 0);
  const contentHeight = els.grid.offsetHeight + parseFloat(gridStyle.marginTop || 0) + parseFloat(gridStyle.marginBottom || 0);
  els.gridScrollContent.style.width = `${Math.ceil(contentWidth)}px`;
  els.gridScrollContent.style.height = `${Math.ceil(contentHeight)}px`;
}

function handleGridWheel(event) {
  const scroller = els.gridScroller;
  const verticalOverflow = scroller.scrollHeight > scroller.clientHeight;
  const horizontalOverflow = scroller.scrollWidth > scroller.clientWidth;
  if (!verticalOverflow && !horizontalOverflow) return;

  const beforeTop = scroller.scrollTop;
  const beforeLeft = scroller.scrollLeft;
  const deltaLeft = event.deltaX || (event.shiftKey ? event.deltaY : 0);
  const deltaTop = event.shiftKey ? 0 : event.deltaY;

  requestAnimationFrame(() => {
    if (verticalOverflow && deltaTop && scroller.scrollTop === beforeTop) {
      scroller.scrollTop += deltaTop;
    }
    if (horizontalOverflow && deltaLeft && scroller.scrollLeft === beforeLeft) {
      scroller.scrollLeft += deltaLeft;
    }
  });
}

function collectScrollDebugAtPoint(x, y) {
  const target = document.elementFromPoint(x, y);
  const chain = [];
  let scrollable = null;
  for (let node = target; node; node = node.parentElement) {
    const computed = getComputedStyle(node);
    const entry = {
      element: node.id ? `#${node.id}` : node.className ? `.${String(node.className).replace(/\s+/g, ".")}` : node.tagName,
      clientHeight: node.clientHeight,
      scrollHeight: node.scrollHeight,
      scrollTop: node.scrollTop,
      clientWidth: node.clientWidth,
      scrollWidth: node.scrollWidth,
      scrollLeft: node.scrollLeft,
      overflowY: computed.overflowY,
      pointerEvents: computed.pointerEvents,
      touchAction: computed.touchAction
    };
    if (!scrollable && node.scrollHeight > node.clientHeight) scrollable = node;
    chain.push(entry);
  }
  return { target, scrollable, chain };
}

function installScrollDebugHelpers() {
  window.debugBrickLayerScroll = () => {
    const rect = els.gridScroller.getBoundingClientRect();
    const result = collectScrollDebugAtPoint(rect.left + rect.width / 2, rect.top + rect.height / 2);
    const printable = {
      elementUnderCenter: result.chain[0]?.element || null,
      scrollable: result.scrollable?.id ? `#${result.scrollable.id}` : result.scrollable?.className || null,
      ancestors: result.chain
    };
    console.table(printable.ancestors);
    console.log("[BrickLayer scroll debug]", printable);
    return printable;
  };
  window.testBrickLayerScroll = () => {
    const debug = window.debugBrickLayerScroll();
    const scroller = els.gridScroller;
    const before = scroller.scrollTop;
    scroller.scrollTop += 200;
    const after = scroller.scrollTop;
    const result = { before, after, moved: after > before, debug };
    console.log("[BrickLayer scroll test]", result);
    return result;
  };
}

function refitGridIfNeeded() {
  if (state.zoomMode !== "fit") return;
  const next = calculateFitCellSize();
  if (String(next) !== els.gridZoom.value) {
    setZoom(next, { keepFitMode: true, center: true });
  } else {
    centerGridInViewport();
  }
}

function shouldIgnoreShortcut(event) {
  const target = event.target;
  if (!target) return false;
  const tag = target.tagName;
  if (target.isContentEditable) return true;
  if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return true;
  const dialog = target.closest?.("dialog");
  return Boolean(dialog?.open && dialog.querySelector("input:focus, textarea:focus, select:focus, [contenteditable='true']:focus"));
}

function handleKeyboard(event) {
  if (shouldIgnoreShortcut(event)) return;
  const key = event.key.toLowerCase();
  const upper = key.toUpperCase();

  if (event.ctrlKey || event.altKey || event.metaKey) return;
  if (COLOR_SHORTCUTS.has(upper)) {
    event.preventDefault();
    selectColor(upper);
    return;
  }
  if (key === "k") {
    event.preventDefault();
    addLayer();
  } else if (key === "d") {
    event.preventDefault();
    duplicateCurrentLayer();
  } else if (key === "z") {
    event.preventDefault();
    undo();
  } else if (key === "y") {
    event.preventDefault();
    redo();
  } else if (key === "e") {
    event.preventDefault();
    setTool("erase");
  } else if (key === "f") {
    event.preventDefault();
    setTool("reference");
  } else if (key === "t") {
    event.preventDefault();
    setTool("template");
  } else if (event.key === "ArrowLeft") {
    event.preventDefault();
    if (event.shiftKey) firstLayer();
    else previousLayer();
  } else if (event.key === "ArrowRight") {
    event.preventDefault();
    if (event.shiftKey) lastLayer();
    else nextLayer();
  } else if (event.key === " ") {
    event.preventDefault();
    toggleEditorLock();
  } else if (event.key === "+" || event.key === "=") {
    event.preventDefault();
    zoomIn();
  } else if (event.key === "-") {
    event.preventDefault();
    zoomOut();
  } else if (event.key === "0") {
    event.preventDefault();
    fitZoom();
  }
}

function addLayer() {
  const targetZ = currentLayer().z + 1;
  const existingIndex = state.project.layers.findIndex((layer) => layer.z === targetZ);
  if (existingIndex !== -1) {
    state.currentLayer = existingIndex;
    render();
    setStatus(`Ya existe Z ${targetZ}; se abrió esa capa.`);
    return;
  }
  pushHistory();
  state.project.layers.push({ z: targetZ, matrix: createEmptyMatrix(state.project.size.x, state.project.size.y) });
  state.project.layers.sort((a, b) => a.z - b.z);
  state.currentLayer = state.project.layers.findIndex((layer) => layer.z === targetZ);
  render();
  markGeometryChanged("Nueva capa creada.");
}

function copyPreviousLayer() {
  const previousLayer = state.project.layers.find((layer) => layer.z === currentLayer().z - 1);
  if (!previousLayer) return;
  if (countLayerBlocks(currentLayer()) && !confirm("La capa actual contiene bloques. Sobrescribir con la capa anterior?")) return;
  pushHistory();
  currentLayer().matrix = cloneMatrix(previousLayer.matrix);
  renderGrid();
  markGeometryChanged("Capa anterior copiada.");
}

function duplicateCurrentLayer() {
  const targetZ = currentLayer().z + 1;
  const existingIndex = state.project.layers.findIndex((layer) => layer.z === targetZ);
  if (existingIndex !== -1) {
    state.currentLayer = existingIndex;
    render();
    setStatus(`No se duplicó: ya existe Z ${targetZ}.`);
    return;
  }
  pushHistory();
  state.project.layers.push({ z: targetZ, matrix: cloneMatrix(currentLayer().matrix) });
  state.project.layers.sort((a, b) => a.z - b.z);
  state.currentLayer = state.project.layers.findIndex((layer) => layer.z === targetZ);
  render();
  markGeometryChanged("Capa duplicada.");
}

function deleteLayer() {
  if (state.project.layers.length === 1) return;
  if (!confirm("Eliminar la capa actual?")) return;
  pushHistory();
  const deletedZ = currentLayer().z;
  state.project.layers.splice(state.currentLayer, 1);
  state.project.references = state.project.references.filter((reference) => reference.source_z !== deletedZ);
  state.currentLayer = Math.max(0, state.currentLayer - 1);
  render();
  markGeometryChanged("Capa eliminada.");
}

function clearLayer() {
  if (!confirm("Limpiar la capa actual?")) return;
  pushHistory();
  currentLayer().matrix = createEmptyMatrix(state.project.size.x, state.project.size.y);
  renderGrid();
  markGeometryChanged("Capa limpia.");
}

function validateProject(project) {
  const errors = [];
  const allowed = new Set([".", ...Object.keys(project.palette)]);
  const seenZ = new Set();
  const validZ = new Set(project.layers.map((layer) => layer.z));
  project.layers.forEach((layer, index) => {
    if (seenZ.has(layer.z)) errors.push(`Z duplicado: ${layer.z}`);
    seenZ.add(layer.z);
    if (index > 0 && project.layers[index - 1].z > layer.z) errors.push("Las capas no estan ordenadas por Z.");
    if (layer.matrix.length !== project.size.y) errors.push(`La capa ${layer.z} no tiene ${project.size.y} filas.`);
    layer.matrix.forEach((row, rowIndex) => {
      if (row.length !== project.size.x) errors.push(`Fila ${rowIndex + 1} de capa ${layer.z} no mide ${project.size.x}.`);
      for (const char of row) {
        if (!allowed.has(char)) errors.push(`Codigo invalido "${char}" en capa ${layer.z}.`);
      }
    });
  });
  const seenReferenceIds = new Set();
  project.references.forEach((reference) => {
    if (seenReferenceIds.has(reference.id)) errors.push(`Referencia duplicada: ${reference.id}`);
    seenReferenceIds.add(reference.id);
    if (reference.x < 0 || reference.x >= project.size.x) errors.push(`${reference.id} tiene X fuera de rango.`);
    if (reference.y < 0 || reference.y >= project.size.y) errors.push(`${reference.id} tiene Y fuera de rango.`);
    if (!validZ.has(reference.source_z)) errors.push(`${reference.id} tiene source_z invalido.`);
    if (normalizeReferenceType(reference.type) === REFERENCE_TYPES.NORMAL && !validZ.has(reference.start_z)) {
      errors.push(`${reference.id} tiene start_z invalido.`);
    }
    if (normalizeReferenceType(reference.type) === REFERENCE_TYPES.NORMAL && reference.end_z !== null && reference.end_z < reference.start_z) {
      errors.push(`${reference.id} tiene end_z menor que start_z.`);
    }
  });
  return errors;
}

function serializeCurrentProjectForExport() {
  syncImageStateToProject();
  const exportable = normalizeProject(state.project);
  const errors = validateProject(exportable);
  if (errors.length) {
    throw new Error(errors[0]);
  }
  return exportable;
}

function downloadBlob(blob, fileName) {
  const link = document.createElement("a");
  link.href = URL.createObjectURL(blob);
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  const url = link.href;
  link.remove();
  URL.revokeObjectURL(url);
}

function exportProject() {
  let exportable;
  try {
    exportable = serializeCurrentProjectForExport();
  } catch (error) {
    setStatus(`No se puede exportar: ${error.message}`);
    return;
  }
  const blob = new Blob([JSON.stringify(exportable, null, 2)], { type: "application/json" });
  const safeName = exportable.name.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "") || "modelo";
  downloadBlob(blob, `${safeName}_${Date.now().toString().slice(-4)}.bricklayers`);
  setStatus("Archivo .bricklayers generado.");
}

async function exportBrickAiPackage() {
  let project;
  try {
    project = serializeCurrentProjectForExport();
  } catch (error) {
    setStatus(`No se puede exportar .brickai: ${error.message}`);
    return;
  }

  els.exportBrickAiBtn.disabled = true;
  setStatus("Preparando Brick AI...");
  try {
    const { renderBrickAiView } = await import(BRICKAI_RENDERER_MODULE_URL);
    setStatus("Modelo .bricklayers...");
    await waitForUiFrame();
    const modelText = JSON.stringify(project, null, 2);
    const viewImages = {};
    for (let index = 0; index < BRICKAI_VIEWS.length; index += 1) {
      const view = BRICKAI_VIEWS[index];
      setStatus(`${view.label} ${index + 1}/${BRICKAI_VIEWS.length}...`);
      await waitForUiFrame();
      viewImages[view.key] = await renderBrickAiView(project, view.key);
    }
    setStatus("Generando paquete Brick AI...");
    await waitForUiFrame();
    const packageResult = await createBrickAiPackage({ project, modelText, viewImages });
    downloadBlob(packageResult.blob, sanitizeBrickAiFileName(project.name));
    setStatus("Archivo .brickai generado.");
  } catch (error) {
    console.error("[BrickLayer] Error al exportar .brickai:", error);
    setStatus(`No se pudo generar .brickai: ${error?.message || "error desconocido"}`);
  } finally {
    els.exportBrickAiBtn.disabled = false;
  }
}

function waitForUiFrame() {
  return new Promise((resolve) => requestAnimationFrame(() => resolve()));
}

function importProject(file) {
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const imported = JSON.parse(String(reader.result));
      if (imported.format !== "bricklayers-v1") {
        setStatus("Error: el archivo no usa format bricklayers-v1.");
        return;
      }
      const normalized = normalizeProject(imported);
      const errors = validateProject(normalized);
      if (errors.length) {
        setStatus(`Error: ${errors[0]}`);
        return;
      }
      pushHistory();
      state.project = normalized;
      state.currentLayer = 0;
      syncImageStateFromProject();
      renderPalette();
      render();
      refreshOpen3dViewer();
      markChanged("Proyecto importado.");
    } catch {
      setStatus("Error: no se pudo abrir el archivo.");
    }
  };
  reader.readAsText(file);
}

async function importLdrProject(file) {
  if (file.size > MAX_LDR_BYTES) {
    setStatus("Error: el archivo LDR es demasiado grande.");
    return;
  }
  const previousProject = JSON.stringify(state.project);
  const previousLayer = state.currentLayer;
  const previousReferenceState = {
    dataUrl: state.referenceDataUrl,
    visible: state.referenceVisible,
    imageState: { ...state.imageState }
  };
  try {
    setStatus("Importando LDR...");
    const text = await file.text();
    const imported = await importLdrContent(text, {
      name: projectNameFromLdrFilename(file.name)
    });
    const normalized = normalizeProject(imported.project);
    const errors = validateProject(normalized);
    if (errors.length) {
      setStatus(`Error LDR: ${errors[0]}`);
      return;
    }
    pushHistory();
    state.project = normalized;
    state.currentLayer = 0;
    syncImageStateFromProject();
    renderPalette();
    render();
    refreshOpen3dViewer();
    saveProject();
    const source = imported.sourceType === "hongmeng" ? "Hongmeng" : "LDraw";
    const colorSummary = imported.stats.colors.map((color) => `${color.id}->${color.colorCode}`).join(", ");
    console.info("[BrickLayer] Colores LDR detectados:", imported.stats.colors);
    const warningText = imported.warnings.length ? ` Avisos: ${imported.warnings.join(" ")}` : "";
    setStatus(`LDR ${source} importado: ${imported.stats.voxels} voxels, ${imported.stats.dimensions.z} capas, ${imported.stats.colors.length} colores (${colorSummary}).${warningText}`);
  } catch (error) {
    state.project = normalizeProject(JSON.parse(previousProject));
    state.currentLayer = previousLayer;
    state.referenceDataUrl = previousReferenceState.dataUrl;
    state.referenceVisible = previousReferenceState.visible;
    state.imageState = previousReferenceState.imageState;
    renderPalette();
    render();
    renderReference();
    refreshOpen3dViewer();
    if (error instanceof UnsupportedLDrawPiecesError) {
      console.warn("[BrickLayer] Piezas LDR no soportadas:", error.unsupportedPieces);
      setStatus(`Error LDR: piezas no compatibles (${error.unsupportedPieces.length} tipos): ${unsupportedPiecesStatus(error.unsupportedPieces)}`);
      return;
    }
    setStatus(`Error LDR: ${error.message || "no se pudo importar el archivo."}`);
  }
}

function unsupportedPiecesStatus(unsupportedPieces) {
  const summary = unsupportedPieces.slice(0, 6).map((piece) => `${piece.part} x${piece.count}`).join(", ");
  return unsupportedPieces.length > 6 ? `${summary}, ... ver consola` : summary;
}

