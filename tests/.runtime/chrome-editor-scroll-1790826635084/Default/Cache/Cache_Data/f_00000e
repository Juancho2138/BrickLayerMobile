import * as THREE from "./vendor/three/three.module.js";
import { OrbitControls } from "./vendor/three/controls/OrbitControls.js";
import { BRICKLAYER_COLORS, COLOR_NAMES, DEFAULT_PALETTE } from "./palette.js";
import {
  addManualSelection,
  clearSelection,
  findAllSameColor,
  findConnectedSameColor,
  projectToVoxels,
  removeManualSelection,
  selectionSummary,
  voxelKey
} from "./selection3d.js";
import { BRICK_RENDER_SCALE, normalizeViewer3dBackground } from "./viewer3d-model.js";

let activeViewer = null;

export function openBrickViewer(options) {
  if (activeViewer) activeViewer.dispose();
  activeViewer = createViewer(options);
  activeViewer.open();
}

export function setBrickViewerView(view) {
  if (activeViewer) activeViewer.setCameraView(view);
}

export function closeBrickViewer() {
  if (!activeViewer) return;
  const viewer = activeViewer;
  activeViewer = null;
  viewer.close();
  viewer.dispose();
}

export function collectBlocks(project, layers) {
  const visibleZ = new Set(layers.map((layer) => layer.z));
  return projectToVoxels(project).filter((voxel) => visibleZ.has(voxel.z));
}

export function countLogicalVisibleVoxels(project, layers) {
  return collectBlocks(project, layers).length;
}

export function isTapGesture(start, event, threshold = 8) {
  if (!start || !event) return false;
  return Math.hypot((event.clientX || 0) - start.x, (event.clientY || 0) - start.y) <= threshold;
}

export function resolveIntersectionVoxel(intersections) {
  const hit = intersections.find((entry) => {
    return Number.isInteger(entry.instanceId) && entry.object?.userData?.voxels?.[entry.instanceId];
  });
  return hit ? hit.object.userData.voxels[hit.instanceId] : null;
}

export function applyRecolorUiState(ui, { active, selectionMode, editAction }) {
  ui.recolorToggle?.classList.toggle("active", active);
  if (ui.recolorToggle) {
    ui.recolorToggle.textContent = active ? "Recolorando" : "Recolorar";
    ui.recolorToggle.setAttribute("aria-pressed", String(active));
  }
  if (ui.recolorPanel) ui.recolorPanel.hidden = !active;
  ui.modeConnected?.classList.toggle("active", selectionMode === "connected");
  ui.modeAllColor?.classList.toggle("active", selectionMode === "all-color");
  ui.actionReplace?.classList.toggle("active", editAction === "replace");
  ui.actionAdd?.classList.toggle("active", editAction === "add");
  ui.actionRemove?.classList.toggle("active", editAction === "remove");
}

export function selectedVisibleVoxels(visibleVoxels, selectionKeys) {
  return visibleVoxels.filter((voxel) => selectionKeys.has(voxelKey(voxel)));
}

function createViewer({
  dialog,
  container,
  info,
  layerSelect,
  allLayers,
  project,
  currentZ,
  controls: ui = {},
  onApplyColor,
  getViewerBackground
}) {
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 5000);
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: "high-performance" });
  const orbit = new OrbitControls(camera, renderer.domElement);
  const modelGroup = new THREE.Group();
  const axes = createAxes();
  const emptyMessage = document.createElement("div");
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  const dummy = new THREE.Object3D();
  const geometries = createBrickGeometries();
  const highlight = createHighlight(geometries);

  let maxZ = currentZ;
  let frameId = 0;
  let disposed = false;
  let resizeObserver = null;
  let blockCount = 0;
  let radius = 8;
  let visibleVoxels = [];
  let selectionKeys = new Set();
  let selectedColorCode = BRICKLAYER_COLORS[0].code;
  let recolorActive = false;
  let selectionMode = "connected";
  let editAction = "replace";
  let pointerStart = null;

  scene.add(modelGroup);
  scene.add(axes);
  scene.add(highlight.group);
  scene.add(new THREE.HemisphereLight(0xffffff, 0x283044, 1.7));

  const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
  keyLight.position.set(15, 28, 20);
  scene.add(keyLight);

  const fillLight = new THREE.DirectionalLight(0xa9c7ff, 1.05);
  fillLight.position.set(-20, 14, -18);
  scene.add(fillLight);

  const lowerLight = new THREE.DirectionalLight(0xffffff, 0.55);
  lowerLight.position.set(0, -18, 8);
  scene.add(lowerLight);

  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  orbit.enableDamping = true;
  orbit.dampingFactor = 0.08;
  orbit.enablePan = true;
  orbit.minDistance = 2;
  orbit.maxDistance = 2000;

  renderer.domElement.setAttribute("aria-label", "Vista 3D del modelo");
  emptyMessage.className = "viewer3d-empty";
  emptyMessage.textContent = "No hay bloques para visualizar";
  emptyMessage.hidden = true;

  function open() {
    if (!dialog.open) dialog.showModal();
    removeExistingCanvas();
    container.appendChild(renderer.domElement);
    container.appendChild(emptyMessage);
    fillLayerOptions();
    allLayers.checked = false;
    layerSelect.disabled = false;
    bindViewerEvents();
    renderRecolorUi();
    applyBackground();

    resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(container);

    requestAnimationFrame(() => {
      if (disposed) return;
      resize();
      rebuild();
      setCameraView("iso");
      animate();
    });
  }

  function removeExistingCanvas() {
    container.querySelectorAll("canvas, .viewer3d-empty").forEach((node) => node.remove());
  }

  function bindViewerEvents() {
    layerSelect.addEventListener("change", onLayerChange);
    allLayers.addEventListener("change", onAllLayersChange);
    renderer.domElement.addEventListener("pointerdown", onPointerDown);
    renderer.domElement.addEventListener("pointermove", onPointerMove);
    renderer.domElement.addEventListener("pointerup", onPointerUp);
    renderer.domElement.addEventListener("pointercancel", onPointerCancel);
    ui.recolorToggle?.addEventListener("click", toggleRecolorMode);
    ui.modeConnected?.addEventListener("click", onModeConnected);
    ui.modeAllColor?.addEventListener("click", onModeAllColor);
    ui.actionReplace?.addEventListener("click", onActionReplace);
    ui.actionAdd?.addEventListener("click", onActionAdd);
    ui.actionRemove?.addEventListener("click", onActionRemove);
    ui.colorSwatch?.addEventListener("click", toggleColorPopover);
    ui.clearSelection?.addEventListener("click", onClearSelection);
    ui.applyColor?.addEventListener("click", applySelectedColor);
    ui.exitRecolor?.addEventListener("click", exitRecolorMode);
  }

  function unbindViewerEvents() {
    layerSelect.removeEventListener("change", onLayerChange);
    allLayers.removeEventListener("change", onAllLayersChange);
    renderer.domElement.removeEventListener("pointerdown", onPointerDown);
    renderer.domElement.removeEventListener("pointermove", onPointerMove);
    renderer.domElement.removeEventListener("pointerup", onPointerUp);
    renderer.domElement.removeEventListener("pointercancel", onPointerCancel);
    ui.recolorToggle?.removeEventListener("click", toggleRecolorMode);
    ui.modeConnected?.removeEventListener("click", onModeConnected);
    ui.modeAllColor?.removeEventListener("click", onModeAllColor);
    ui.actionReplace?.removeEventListener("click", onActionReplace);
    ui.actionAdd?.removeEventListener("click", onActionAdd);
    ui.actionRemove?.removeEventListener("click", onActionRemove);
    ui.colorSwatch?.removeEventListener("click", toggleColorPopover);
    ui.clearSelection?.removeEventListener("click", onClearSelection);
    ui.applyColor?.removeEventListener("click", applySelectedColor);
    ui.exitRecolor?.removeEventListener("click", exitRecolorMode);
  }

  function fillLayerOptions() {
    layerSelect.innerHTML = "";
    project.layers.forEach((layer) => {
      const option = document.createElement("option");
      option.value = String(layer.z);
      option.textContent = `Z ${layer.z}`;
      option.selected = layer.z === currentZ;
      layerSelect.appendChild(option);
    });
  }

  function visibleLayers() {
    if (allLayers.checked) return project.layers;
    return project.layers.filter((layer) => layer.z <= maxZ);
  }

  function rebuild() {
    clearModelGroup();
    visibleVoxels = collectBlocks(project, visibleLayers());
    const byColor = groupVoxelsByColor(visibleVoxels);
    const bounds = createEmptyBounds();
    let total = 0;

    byColor.forEach((voxels, colorCode) => {
      const color = DEFAULT_PALETTE[colorCode];
      if (!color || !voxels.length) return;
      const meshes = createColorMeshes(colorCode, color, voxels.length);
      voxels.forEach((voxel, index) => {
        setBrickMatrix(voxel);
        meshes.body.setMatrixAt(index, dummy.matrix);
        meshes.stud.setMatrixAt(index, dummy.matrix);
        meshes.socket.setMatrixAt(index, dummy.matrix);
        meshes.body.userData.voxels[index] = voxel;
        meshes.stud.userData.voxels[index] = voxel;
        meshes.socket.userData.voxels[index] = voxel;
        expandBounds(bounds, voxel);
      });
      Object.values(meshes).forEach((mesh) => {
        mesh.count = voxels.length;
        mesh.instanceMatrix.needsUpdate = true;
        modelGroup.add(mesh);
      });
      total += voxels.length;
    });

    blockCount = total;
    updateEmptyMessage(total);
    selectionKeys = new Set([...selectionKeys].filter((key) => visibleVoxels.some((voxel) => voxelKey(voxel) === key)));

    if (!total) {
      radius = 6;
      modelGroup.position.set(0, 0, 0);
    } else {
      const center = new THREE.Vector3(
        (bounds.minX + bounds.maxX) / 2,
        ((bounds.minZ + bounds.maxZ) / 2) * BRICK_RENDER_SCALE.stepZ,
        (bounds.minY + bounds.maxY) / 2
      );
      const size = new THREE.Vector3(
        Math.max(1, bounds.maxX - bounds.minX + 1),
        Math.max(1, (bounds.maxZ - bounds.minZ + 1) * BRICK_RENDER_SCALE.stepZ),
        Math.max(1, bounds.maxY - bounds.minY + 1)
      );
      modelGroup.position.set(-center.x, -center.y, -center.z);
      highlight.group.position.copy(modelGroup.position);
      radius = Math.max(4, size.length() * 0.85);
    }

    axes.position.set(-project.size.x / 2, -0.5, -project.size.y / 2);
    orbit.target.set(0, 0, 0);
    orbit.update();
    updateSelectionHighlight();
    updateInfo();
    render();
  }

  function createColorMeshes(colorCode, color, count) {
    const material = new THREE.MeshStandardMaterial({ color, roughness: 0.48, metalness: 0.015 });
    const socketColor = new THREE.Color(color).multiplyScalar(0.45);
    const socketMaterial = new THREE.MeshStandardMaterial({ color: socketColor, roughness: 0.7, metalness: 0 });
    const body = new THREE.InstancedMesh(geometries.body, material, count);
    const stud = new THREE.InstancedMesh(geometries.stud, material, count);
    const socket = new THREE.InstancedMesh(geometries.socket, socketMaterial, count);
    [body, stud, socket].forEach((mesh) => {
      mesh.userData = { colorCode, voxels: [], selectable: mesh !== socket };
    });
    socket.userData.selectable = true;
    return { body, stud, socket };
  }

  function setBrickMatrix(voxel) {
    dummy.position.set(voxel.x, voxel.z * BRICK_RENDER_SCALE.stepZ, voxel.y);
    dummy.rotation.set(0, 0, 0);
    dummy.scale.set(1, 1, 1);
    dummy.updateMatrix();
  }

  function clearModelGroup() {
    while (modelGroup.children.length) {
      const child = modelGroup.children.pop();
      child.material?.dispose();
    }
    modelGroup.position.set(0, 0, 0);
    highlight.group.position.set(0, 0, 0);
  }

  function updateInfo() {
    const layers = visibleLayers();
    const zValues = layers.map((layer) => layer.z);
    const zMin = zValues.length ? Math.min(...zValues) : 0;
    const zMax = zValues.length ? Math.max(...zValues) : 0;
    const visibleZ = allLayers.checked ? "todas" : `${zMin}-${zMax}`;
    const maxProjectZ = project.layers.length ? Math.max(...project.layers.map((layer) => layer.z)) + 1 : 0;

    info.innerHTML = "";
    const title = document.createElement("strong");
    title.textContent = project.name;
    const layerLine = document.createElement("span");
    layerLine.textContent = `Capas: ${visibleZ}`;
    const blocksLine = document.createElement("span");
    blocksLine.textContent = `Bloques visibles: ${blockCount.toLocaleString("es-CO")}`;
    const dimensionsLine = document.createElement("span");
    dimensionsLine.textContent = `Dimensiones: ${project.size.x} x ${project.size.y} x ${maxProjectZ}`;
    info.append(title, layerLine, blocksLine, dimensionsLine);
  }

  function updateEmptyMessage(total) {
    emptyMessage.hidden = total > 0;
    emptyMessage.style.display = total > 0 ? "none" : "grid";
  }

  function resize() {
    const rect = container.getBoundingClientRect();
    const width = Math.max(1, Math.floor(rect.width || container.clientWidth || window.innerWidth || 1));
    const height = Math.max(1, Math.floor(rect.height || container.clientHeight || window.innerHeight || 1));
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height, false);
    render();
  }

  function setCameraView(view) {
    const distance = radius * 2.25;
    const positions = {
      front: [0, distance * 0.42, distance],
      back: [0, distance * 0.42, -distance],
      left: [-distance, distance * 0.42, 0],
      right: [distance, distance * 0.42, 0],
      top: [0, distance, 0.001],
      bottom: [0, -distance, 0.001],
      iso: [distance, distance * 0.9, distance]
    };
    const [x, y, z] = positions[view] || positions.iso;
    camera.position.set(x, y, z);
    camera.near = Math.max(0.1, radius / 100);
    camera.far = Math.max(200, radius * 14);
    camera.updateProjectionMatrix();
    orbit.target.set(0, 0, 0);
    orbit.update();
    render();
  }

  function onLayerChange() {
    maxZ = Number(layerSelect.value);
    allLayers.checked = false;
    layerSelect.disabled = false;
    rebuild();
    setCameraView("iso");
  }

  function onAllLayersChange() {
    layerSelect.disabled = allLayers.checked;
    rebuild();
    setCameraView("iso");
  }

  function toggleRecolorMode() {
    setRecolorMode(!recolorActive);
  }

  function exitRecolorMode() {
    selectionKeys = clearSelection();
    updateSelectionHighlight();
    setRecolorMode(false);
  }

  function setRecolorMode(active) {
    recolorActive = active;
    if (ui.recolorToggle) ui.recolorToggle.setAttribute("aria-pressed", String(active));
    if (!active && ui.colorPopover) ui.colorPopover.hidden = true;
    renderRecolorUi();
  }

  function onClearSelection() {
    selectionKeys = clearSelection();
    updateSelectionHighlight();
  }

  function isRecolorActive() {
    return recolorActive;
  }

  function renderRecolorUi() {
    const active = isRecolorActive();
    applyRecolorUiState(ui, { active, selectionMode, editAction });
    renderPalette();
    updateSelectionSummary();
  }

  function setSelectionMode(mode) {
    selectionMode = mode;
    editAction = "replace";
    renderRecolorUi();
  }

  function onModeConnected() {
    setSelectionMode("connected");
  }

  function onModeAllColor() {
    setSelectionMode("all-color");
  }

  function onActionReplace() {
    setEditAction("replace");
  }

  function onActionAdd() {
    setEditAction("add");
  }

  function onActionRemove() {
    setEditAction("remove");
  }

  function setEditAction(action) {
    editAction = action;
    renderRecolorUi();
  }

  function toggleColorPopover() {
    if (!ui.colorPopover) return;
    ui.colorPopover.hidden = !ui.colorPopover.hidden;
  }

  function renderPalette() {
    if (!ui.palette) return;
    ui.palette.innerHTML = "";
    BRICKLAYER_COLORS.forEach(({ code, name }) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = `viewer3d-color${code === selectedColorCode ? " active" : ""}`;
      button.dataset.color = code;
      button.style.setProperty("--swatch-color", DEFAULT_PALETTE[code]);
      button.style.color = contrastText(DEFAULT_PALETTE[code]);
      button.textContent = code;
      button.title = `${code} ${name}`;
      button.setAttribute("aria-label", `${code} ${name}`);
      button.addEventListener("click", () => {
        selectedColorCode = code;
        if (ui.colorPopover) ui.colorPopover.hidden = true;
        renderPalette();
      });
      ui.palette.appendChild(button);
    });
    if (ui.colorSwatch) {
      ui.colorSwatch.textContent = selectedColorCode;
      ui.colorSwatch.style.setProperty("--swatch-color", DEFAULT_PALETTE[selectedColorCode]);
      ui.colorSwatch.style.color = contrastText(DEFAULT_PALETTE[selectedColorCode]);
      ui.colorSwatch.title = `${selectedColorCode} ${COLOR_NAMES[selectedColorCode] || ""}`;
    }
  }

  function onPointerDown(event) {
    pointerStart = { x: event.clientX, y: event.clientY, id: event.pointerId, moved: false };
  }

  function onPointerMove(event) {
    if (!pointerStart || pointerStart.id !== event.pointerId) return;
    pointerStart.moved = pointerStart.moved || !isTapGesture(pointerStart, event, 8);
  }

  function onPointerCancel() {
    pointerStart = null;
  }

  function onPointerUp(event) {
    if (!isRecolorActive() || !pointerStart || pointerStart.id !== event.pointerId) {
      pointerStart = null;
      return;
    }
    const wasTap = !pointerStart.moved && isTapGesture(pointerStart, event, 8);
    pointerStart = null;
    if (!wasTap) return;
    const voxel = pickVoxel(event);
    if (!voxel) return;
    applySelectionClick(voxel);
  }

  function pickVoxel(event) {
    const rect = renderer.domElement.getBoundingClientRect();
    pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(pointer, camera);
    const selectableMeshes = modelGroup.children.filter((child) => child.userData?.selectable);
    const hits = raycaster.intersectObjects(selectableMeshes, false);
    return resolveIntersectionVoxel(hits);
  }

  function applySelectionClick(voxel) {
    if (editAction === "add") {
      selectionKeys = addManualSelection(selectionKeys, voxel);
    } else if (editAction === "remove") {
      selectionKeys = removeManualSelection(selectionKeys, voxel);
    } else if (selectionMode === "all-color") {
      selectionKeys = new Set(findAllSameColor(visibleVoxels, voxel.colorCode).map(voxelKey));
    } else {
      selectionKeys = new Set(findConnectedSameColor(visibleVoxels, voxel).map(voxelKey));
    }
    updateSelectionHighlight();
  }

  function updateSelectionHighlight() {
    const selected = selectedVisibleVoxels(visibleVoxels, selectionKeys);
    highlight.body.count = selected.length;
    highlight.stud.count = selected.length;
    selected.forEach((voxel, index) => {
      setBrickMatrix(voxel);
      highlight.body.setMatrixAt(index, dummy.matrix);
      highlight.stud.setMatrixAt(index, dummy.matrix);
    });
    highlight.body.instanceMatrix.needsUpdate = true;
    highlight.stud.instanceMatrix.needsUpdate = true;
    updateSelectionSummary();
    render();
  }

  function updateSelectionSummary() {
    const summary = selectionSummary(visibleVoxels, selectionKeys, COLOR_NAMES);
    if (ui.selectionCount) ui.selectionCount.textContent = `Seleccionados: ${summary.count.toLocaleString("es-CO")}`;
    if (ui.selectionColor) ui.selectionColor.textContent = summary.count === 0 ? "Color actual: -" : summary.colorName ? `Color actual: ${summary.colorName}` : "Color actual: mixto";
    if (ui.applyColor) ui.applyColor.disabled = summary.count === 0;
  }

  function applySelectedColor() {
    if (!selectionKeys.size || !onApplyColor) return;
    const updatedProject = onApplyColor([...selectionKeys], selectedColorCode);
    if (!updatedProject) return;
    project = updatedProject;
    rebuild();
    setCameraView("iso");
  }

  function applyBackground() {
    const background = getViewerBackground ? getViewerBackground() : normalizeViewer3dBackground("dark");
    scene.background = new THREE.Color(background);
    renderer.setClearColor(background, 1);
  }

  function close() {
    if (dialog.open) dialog.close();
  }

  function render() {
    if (!disposed) renderer.render(scene, camera);
  }

  function animate() {
    if (disposed || !dialog.open) return;
    frameId = requestAnimationFrame(animate);
    orbit.update();
    render();
  }

  function dispose() {
    if (disposed) return;
    disposed = true;
    if (frameId) cancelAnimationFrame(frameId);
    resizeObserver?.disconnect();
    unbindViewerEvents();
    orbit.dispose();
    clearModelGroup();
    disposeObject(axes);
    disposeObject(highlight.group);
    Object.values(geometries).forEach((geometry) => geometry.dispose());
    renderer.dispose();
    renderer.forceContextLoss?.();
    renderer.domElement.remove();
    emptyMessage.remove();
  }

  return { open, close, dispose, rebuild, setCameraView };
}

function contrastText(hex) {
  const match = /^#?([0-9a-f]{6})$/i.exec(String(hex || ""));
  if (!match) return "#ffffff";
  const value = match[1];
  const r = parseInt(value.slice(0, 2), 16);
  const g = parseInt(value.slice(2, 4), 16);
  const b = parseInt(value.slice(4, 6), 16);
  return (r * 299 + g * 587 + b * 114) / 1000 >= 145 ? "#111111" : "#ffffff";
}

function groupVoxelsByColor(voxels) {
  const byColor = new Map();
  voxels.forEach((voxel) => {
    if (!byColor.has(voxel.colorCode)) byColor.set(voxel.colorCode, []);
    byColor.get(voxel.colorCode).push(voxel);
  });
  return byColor;
}

export function createBrickGeometries() {
  const body = new THREE.BoxGeometry(BRICK_RENDER_SCALE.bodyWidth, BRICK_RENDER_SCALE.bodyHeight, BRICK_RENDER_SCALE.bodyDepth);
  const stud = new THREE.CylinderGeometry(BRICK_RENDER_SCALE.studRadius, BRICK_RENDER_SCALE.studRadius, BRICK_RENDER_SCALE.studHeight, 20);
  stud.translate(0, BRICK_RENDER_SCALE.bodyHeight / 2 + BRICK_RENDER_SCALE.studHeight / 2, 0);
  const socket = new THREE.TorusGeometry(
    BRICK_RENDER_SCALE.bottomSocketRadius,
    BRICK_RENDER_SCALE.bottomSocketHeight,
    8,
    24
  );
  socket.rotateX(Math.PI / 2);
  socket.translate(0, -BRICK_RENDER_SCALE.bodyHeight / 2 - 0.01, 0);
  return { body, stud, socket };
}

function createHighlight(geometries) {
  const group = new THREE.Group();
  const material = new THREE.MeshBasicMaterial({
    color: 0xff4fd8,
    transparent: true,
    opacity: 0.46,
    depthWrite: false
  });
  const body = new THREE.InstancedMesh(geometries.body.clone().scale(1.085, 1.09, 1.085), material, 10000);
  const stud = new THREE.InstancedMesh(geometries.stud.clone().scale(1.18, 1.18, 1.18), material, 10000);
  body.count = 0;
  stud.count = 0;
  body.raycast = () => {};
  stud.raycast = () => {};
  group.add(body, stud);
  return { group, body, stud };
}

function createEmptyBounds() {
  return {
    minX: Infinity,
    minY: Infinity,
    minZ: Infinity,
    maxX: -Infinity,
    maxY: -Infinity,
    maxZ: -Infinity
  };
}

function expandBounds(bounds, voxel) {
  bounds.minX = Math.min(bounds.minX, voxel.x);
  bounds.minY = Math.min(bounds.minY, voxel.y);
  bounds.minZ = Math.min(bounds.minZ, voxel.z);
  bounds.maxX = Math.max(bounds.maxX, voxel.x);
  bounds.maxY = Math.max(bounds.maxY, voxel.y);
  bounds.maxZ = Math.max(bounds.maxZ, voxel.z);
}

function createAxes() {
  const group = new THREE.Group();
  const points = [
    [[0, 0, 0], [3, 0, 0], 0xff5252],
    [[0, 0, 0], [0, 0, 3], 0x42d66b],
    [[0, 0, 0], [0, 3, 0], 0x4d8dff]
  ];

  points.forEach(([start, end, color]) => {
    const geometry = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(...start),
      new THREE.Vector3(...end)
    ]);
    const material = new THREE.LineBasicMaterial({ color });
    group.add(new THREE.Line(geometry, material));
  });

  return group;
}

function disposeObject(object) {
  object.traverse((child) => {
    child.geometry?.dispose();
    child.material?.dispose();
  });
}
